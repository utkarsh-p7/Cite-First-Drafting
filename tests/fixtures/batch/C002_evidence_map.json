    "span_id": "FS:GIA:03",
    "span_valid": true
   }
  ],
  "status": "supported"
 },
 {
  "statement_id": "C002-S020",
  "text": "Using both an ISA and a GIA lets you benefit from tax‑free growth on the ISA portion (no income tax or CGT on gains) while still being able to invest any amount beyond the ISA allowance in the GIA [FS:ISA:05]​[FS:GIA:05].",
  "spans": [
   {
    "span_id": "FS:ISA:05",
    "span_valid": true
   },
   {
    "span_id": "FS:GIA:05",
    "span_valid": true
   }
  ],
  "status": "supported"
 },
 {
  "statement_id": "C002-S021",
  "text": "Both wrappers have the same platform fee (0.25 % p.a.) and fund OCF (0.60 % p.a.), giving a total illustrative charge of 0.85 % p.a.",
  "spans": [],
  "status": "unsupported"
 },
 {
