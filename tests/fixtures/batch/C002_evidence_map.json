   {
    "span_id": "FS:GIA:01",
    "span_valid": true
   },
   {
    "span_id": "FS:GIA:02",
    "span_valid": true
   }
  ],
  "status": "supported"
 },
 {
  "statement_id": "C002-S019",
  "text": "The fund’s risk indicator is 4 of 7, consistent with a “balanced” attitude to risk [FS:ISA:03]​[FS:GIA:03].",
