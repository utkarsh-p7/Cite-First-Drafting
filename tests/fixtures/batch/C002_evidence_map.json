 {
  "statement_id": "C002-S018",
  "text": "The Aldercroft Balanced Growth Fund is a multi‑asset fund (≈60 % global equities, 40 % bonds) aiming for capital growth over a period of 5 years or more, matching your 10‑year horizon and balanced risk appetite [FS:ISA:01]​[FS:ISA:02]​[FS:GIA:01]​[FS:GIA:02].",
  "spans": [
   {
    "span_id": "FS:ISA:01",
    "span_valid": true
   },
   {
    "span_id": "FS:ISA:02",
    "span_valid": true
